{
  "name": "polly",
  "version": "1.0.0",
  "description": "Real-time Discord poll system",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target node",
    "start": "bun run dist/index.js",
    "db:push": "bunx prisma db push",
    "db:generate": "bunx prisma generate"
  },
  "keywords": ["discord", "poll", "websocket"],
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "discord.js": "^14.16.3",
    "express": "^4.21.1",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "typescript": "^5.6.3"
  },
  "trustedDependencies": ["@prisma/client", "prisma"]
}
