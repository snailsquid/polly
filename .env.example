# Discord bot token
DISCORD_BOT_TOKEN=your_bot_token_here

# PostgreSQL connection string
DATABASE_URL=postgres://user:pass@localhost:5432/polly

# WebSocket server port (default: 8080)
WS_PORT=8080

# HTTP REST port (default: 3000)
PORT=3000

# Comma-separated Discord user IDs allowed to create/modify polls
WHITELIST_USER_IDS=